{
  "name": "samlock-gestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "echo interface deja compilee dans web/dist",
    "start": "node server/prod.js",
    "seed": "node server/seed.js --reset",
    "setup": "npm install && npm --prefix web install && npm run seed",
    "empty": "node server/seed.js --reset --empty",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
