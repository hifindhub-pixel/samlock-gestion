APP_URL=https://gestion.example.com
# Accès unique : page de connexion (identifiant + mot de passe). Session fermée après 8 h d'inactivité, blocage 15 min après 5 échecs.
APP_USER=samlock
APP_PASSWORD=choisir-un-mot-de-passe-long-et-unique
# SESSION_HOURS=8
# E-mails réels (sinon les envois sont simulés). Exemple Brevo/OVH/Gmail : smtp://user:pass@smtp.exemple.fr:587
SMTP_URL=
MAIL_FROM="SAMLOCK <contact@samlock.fr>"
# Optionnel : connecteur Pennylane (jeton API)
PENNYLANE_TOKEN=
# NE PAS activer en production : affiche le code de signature à l'écran (démo uniquement)
# DEMO_MODE=1
